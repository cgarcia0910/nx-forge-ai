{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisReport",
  "description": "Inventario objetivo del modelo TypeORM existente. Generado por scan-entities.ts. No contiene decisiones, solo hechos y señales superficiales.",
  "type": "object",
  "required": ["generatedAt", "entities", "newEntity"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "entities": {
      "type": "array",
      "description": "Entities TypeORM ya existentes en el proyecto.",
      "items": {
        "type": "object",
        "required": ["name", "filePath", "tableName", "columns", "existingRelations"],
        "properties": {
          "name": { "type": "string" },
          "filePath": { "type": "string" },
          "tableName": { "type": "string" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "tsType", "decorators"],
              "properties": {
                "name": { "type": "string" },
                "tsType": { "type": "string" },
                "decorators": { "type": "array", "items": { "type": "string" } },
                "isPrimary": { "type": "boolean" },
                "isUnique": { "type": "boolean" },
                "isNullable": { "type": "boolean" }
              }
            }
          },
          "existingRelations": {
            "type": "array",
            "description": "Relaciones ya declaradas explícitamente en el código (decoradores TypeORM reales, no inferidas).",
            "items": {
              "type": "object",
              "required": ["type", "target", "propertyName"],
              "properties": {
                "type": { "enum": ["OneToOne", "OneToMany", "ManyToOne", "ManyToMany"] },
                "target": { "type": "string" },
                "propertyName": { "type": "string" }
              }
            }
          },
          "detectedAuthGuards": {
            "type": "array",
            "description": "Guards usados en el controller asociado, si existe, como señal de convención del proyecto.",
            "items": { "type": "string" }
          }
        }
      }
    },
    "newEntity": {
      "type": "object",
      "description": "Parseo de la definición de texto dada por el usuario para la entidad nueva.",
      "required": ["rawDescription", "proposedName", "proposedFields"],
      "properties": {
        "rawDescription": { "type": "string" },
        "proposedName": { "type": "string" },
        "proposedFields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "tsType"],
            "properties": {
              "name": { "type": "string" },
              "tsType": { "type": "string" },
              "isUnique": { "type": "boolean" },
              "isNullable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "relationshipSignals": {
      "type": "array",
      "description": "SEÑALES superficiales por convención de nombre (ej. campo 'userId' cuando existe entity 'User'). NO son relaciones confirmadas. confidence es heurístico y solo sirve para ordenar qué preguntar primero a Claude/usuario; nunca se usa para generar código directamente.",
      "items": {
        "type": "object",
        "required": ["fromEntity", "toEntity", "signalType", "evidence", "confidence"],
        "properties": {
          "fromEntity": { "type": "string" },
          "toEntity": { "type": "string" },
          "signalType": {
            "enum": ["fk-naming-convention", "unique-fk-column", "pivot-table-detected", "entity-name-in-field"]
          },
          "evidence": { "type": "string", "description": "Explicación legible de por qué se detectó, ej. 'campo orderId coincide con Order.id'" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "suggestedType": { "enum": ["OneToOne", "OneToMany", "ManyToOne", "ManyToMany", null] }
        }
      }
    }
  }
}
