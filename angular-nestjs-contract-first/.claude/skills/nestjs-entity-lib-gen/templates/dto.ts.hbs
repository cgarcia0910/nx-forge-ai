{{#if paginationEnabled}}
import { {{entityName}} } from './{{entityFileBase}}.entity';

{{/if}}
export class Create{{entityName}}Dto {
{{#each createProperties}}
  {{name}}{{#if optional}}?{{/if}}: {{{tsType}}};
{{/each}}

  constructor({{{constructorParams}}}) {
{{#each createProperties}}
    this.{{name}} = {{name}};
{{/each}}
  }
}

export class Update{{entityName}}Dto {
{{#each updateProperties}}
  {{name}}?: {{{tsType}}};
{{/each}}
}
{{#if isOffsetPagination}}

export class Paginated{{entityName}}Dto {
  data!: {{entityName}}[];
  total!: number;
  page!: number;
  limit!: number;
  totalPages!: number;
}
{{/if}}
{{#if isCursorPagination}}

export class CursorPaginated{{entityName}}Dto {
  data!: {{entityName}}[];
  nextCursor!: string | null;
  limit!: number;
  hasMore!: boolean;
}
{{/if}}
